           Margin="0,0,0,6"/>

                                            <TextBlock Text="Quick URLs are grouped by Tab: Tab 1 uses 1–4, Tab 2 uses 5–8, Tab 3 uses 9–12, Tab 4 uses 13–16, and Tab 5 uses 17–20."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>
                                            <TextBlock Text="Cycle through Quick URLs"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Click the Page Cycle icon to cycle the active Web Page through saved Quick URLs."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Right-click the Page Cycle icon to choose a saved Quick URL directly."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Address bar quick actions"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Remember sign-in names"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="LexDesk Pro can help trusted websites remember typed login names and email fields where the website allows it."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Password saving is not enabled in LexDesk Pro."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Right-click the address bar to open quick page actions."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="You can add the current page to Favourites, save it to the next empty Quick URL, copy the link, copy the title and link, share by email, or open the full Share this page menu."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
