           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Share lets you copy a link, copy the page title and link, or email the link if a mail app is available."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

