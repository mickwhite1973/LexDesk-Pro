                                    BorderThickness="1.2"
                                    CornerRadius="16"
                                    Padding="18"
                                    Margin="8,0,8,14">

                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="PC Health"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBlock Text="LexDesk checks the important things without changing or deleting anything."
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,4,18,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                x:Name="LexDeskCheckMyPcButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                MinWidth="132"
                                                Height="38"
                                                Content="Check My PC"
                                                Click="LexDeskCheckMyPc_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="LexDeskPcHealthOverallText"
                                               Text="Not checked yet."
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,14,0,10"/>

                                    <UniformGrid Columns="2">
                                        <Border Background="{DynamicResource ButtonBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,6,6">
                                            <StackPanel>
                                                <TextBlock Text="Virus protection"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock x:Name="LexDeskPcHealthAntivirusText"
                                                           Text="Not checked yet."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ButtonBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="6,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Windows Update"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock x:Name="LexDeskPcHealthUpdatesText"
                                                           Text="Not checked yet."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ButtonBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,6,6,0">
                                            <StackPanel>
                                                <TextBlock Text="Storage space"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock x:Name="LexDeskPcHealthStorageText"
                                                           Text="Not checked yet."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ButtonBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="6,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Restart status"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock x:Name="LexDeskPcHealthRestartText"
                                                           Text="Not checked yet."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>



                            <!-- ===================================================== -->
                            <!-- LEXDESK PRO WINDOWS REPAIR / CLEANUP - STAGE 2 -->
                            <!-- ===================================================== -->
                            <Border Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1.2"
                                    CornerRadius="16"
                                    Padding="18"
                                    Margin="8,0,8,14">

                                <StackPanel>
                                    <TextBlock Text="Windows Repair &amp; Cleanup"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>

                                    <TextBlock Text="LexDesk uses Windows' own repair tools in the safe order. Your documents, photos and personal files are not deleted."
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,4,0,12"/>

                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="LexDeskCheckWindowsButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Height="38"
                                                MinWidth="126"
                                                Margin="0,0,8,8"
                                                Content="Check Windows"
                                                Click="LexDeskCheckWindows_Click"/>

                                        <Button x:Name="LexDeskRepairWindowsButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Height="38"
                                                MinWidth="126"
                                                Margin="0,0,8,8"
                                                Content="Repair Windows"
                                                IsEnabled="False"
                                                Click="LexDeskRepairWindows_Click"/>

                                        <Button x:Name="LexDeskCleanupWindowsButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Height="38"
                                                MinWidth="174"
                                                Margin="0,0,0,8"
                                                Content="Clean Old Windows Files"
                                                Click="LexDeskCleanupWindows_Click"/>
                                    </WrapPanel>

                                    <ProgressBar x:Name="LexDeskMaintenanceProgressBar"
                                                 Height="6"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Margin="0,0,0,10"/>

                                    <TextBlock x:Name="LexDeskMaintenanceStatusText"
                                               Text="Start with Check Windows. LexDesk will tell you if a repair is needed."
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,10"/>

                                    <Expander Header="What LexDesk does, in order"
                                              Foreground="{DynamicResource TextPrimary}">
                                        <Border Background="{DynamicResource ButtonBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="1. Quick health check - DISM CheckHealth"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Checks whether Windows has already marked its repair files as damaged. Nothing is changed."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,2,0,8"/>

                                                <TextBlock Text="2. Deep health scan - DISM ScanHealth"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Performs a deeper scan of the Windows component store. Nothing is changed."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,2,0,8"/>

                                                <TextBlock Text="3. Repair source - DISM RestoreHealth"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Used only when Windows reports repairable damage. Windows may use Windows Update to obtain healthy replacement files."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,2,0,8"/>

                                                <TextBlock Text="4. System files - SFC /scannow"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Checks the protected Windows files the computer actually uses and repairs damaged copies where possible."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,2,0,8"/>

                                                <TextBlock Text="5. Cleanup check - DISM AnalyzeComponentStore"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Checks whether old Windows component files are taking unnecessary space. Nothing is deleted during this check."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,2,0,8"/>

                                                <TextBlock Text="6. Safe component cleanup - DISM StartComponentCleanup"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Runs only after Windows recommends cleanup and you approve it. LexDesk never uses ResetBase."
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                    </Expander>

                                    <TextBlock Text="Windows may ask for Administrator permission. Keep the computer powered on and do not shut it down while a repair is running."
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ===================================================== -->
                            <!-- LEXDESK PRO PROTECTION / UPDATES / SAFE CLEANUP - STAGE 3 -->
                            <!-- ===================================================== -->
                            <Border Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1.2"
                                    CornerRadius="16"
                                    Padding="18"
                                    Margin="8,0,8,14">

                                <StackPanel>
                                    <TextBlock Text="Protection, Updates &amp; Safe Cleanup"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>

                                    <TextBlock Text="Simple Windows maintenance for people who do not want to learn Windows. LexDesk leaves third-party antivirus alone and never deletes your Documents, Pictures, Desktop or Downloads."
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,4,0,14"/>

                                    <!-- Virus protection -->
                                    <Border Background="{DynamicResource ButtonBg}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Virus protection"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBlock x:Name="LexDeskProtectionActionText"
                                                       Text="Run Check My PC first. LexDesk will see whether Microsoft Defender or another antivirus is protecting this computer."
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,3,0,10"/>

                                            <WrapPanel>
                                                <Button x:Name="LexDeskOpenWindowsSecurityButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="150"
                                                        Margin="0,0,8,8"
                                                        Content="Open Windows Security"
                                                        Click="LexDeskOpenWindowsSecurity_Click"/>

                                                <Button x:Name="LexDeskTurnOnDefenderButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="138"
                                                        Margin="0,0,8,8"
                                                        Content="Turn On Defender"
                                                        IsEnabled="False"
                                                        Click="LexDeskTurnOnDefender_Click"/>

                                                <Button x:Name="LexDeskQuickVirusScanButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="112"
                                                        Margin="0,0,8,8"
                                                        Content="Quick Scan"
                                                        IsEnabled="False"
                                                        Click="LexDeskQuickVirusScan_Click"/>

                                                <Button x:Name="LexDeskFullVirusScanButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="112"
                                                        Margin="0,0,0,8"
                                                        Content="Full Scan"
                                                        IsEnabled="False"
                                                        Click="LexDeskFullVirusScan_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Windows Update -->
                                    <Border Background="{DynamicResource ButtonBg}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Windows Update"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBlock x:Name="LexDeskWindowsUpdateActionText"
                                                       Text="LexDesk can take you straight to Windows Update. Install important security updates, then restart only after you have saved your work."
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,3,0,10"/>

                                            <Button x:Name="LexDeskOpenWindowsUpdateButton"
                                                    Style="{StaticResource TopBarButtonStyle}"
                                                    Height="36"
                                                    MinWidth="150"
                                                    HorizontalAlignment="Left"
                                                    Content="Open Windows Update"
                                                    Click="LexDeskOpenWindowsUpdate_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Safe temporary-file cleanup -->
                                    <Border Background="{DynamicResource ButtonBg}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Safe temporary-file cleanup"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBlock Text="LexDesk only targets old temporary files that Windows and programs use as scratch space. Files newer than 48 hours are left alone."
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,3,0,6"/>

                                            <TextBlock x:Name="LexDeskSafeCleanupStatusText"
                                                       Text="Not checked yet."
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,0,0,10"/>

                                            <WrapPanel>
                                                <Button x:Name="LexDeskCheckTemporaryFilesButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="150"
                                                        Margin="0,0,8,8"
                                                        Content="Check Temporary Files"
                                                        Click="LexDeskCheckTemporaryFiles_Click"/>

                                                <Button x:Name="LexDeskCleanTemporaryFilesButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="150"
                                                        Margin="0,0,8,8"
                                                        Content="Clean Temporary Files"
                                                        IsEnabled="False"
                                                        Click="LexDeskCleanTemporaryFiles_Click"/>

                                                <Button x:Name="LexDeskOpenStorageSettingsButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="132"
                                                        Margin="0,0,0,8"
                                                        Content="Storage Settings"
                                                        Click="LexDeskOpenStorageSettings_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <ProgressBar x:Name="LexDeskStage3ProgressBar"
                                                 Height="6"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Margin="0,12,0,0"/>

                                    <TextBlock x:Name="LexDeskStage3StatusText"
                                               Text="Ready."
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>


                            <!-- ===================================================== -->
                            <!-- LEXDESK PRO PROBLEM SOLVER - STAGE 6 -->
                            <!-- ===================================================== -->
                            <Border Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1.2"
                                    CornerRadius="16"
                                    Padding="18"
                                    Margin="8,0,8,14">

                                <StackPanel>
                                    <TextBlock Text="Help Me Fix My PC"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>

                                    <TextBlock Text="Tell LexDesk what is wrong. LexDesk checks the common causes first, explains what it found, and only offers safe fixes that match the problem."
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,4,0,14"/>

                                    <UniformGrid Columns="2">
                                        <Button x:Name="LexDeskProblemSlowPcButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Height="42"
                                                Margin="0,0,6,6"
                                                Content="My PC Is Slow"
                                                Click="LexDeskProblemSlowPc_Click"/>

                                        <Button x:Name="LexDeskProblemInternetButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Height="42"
                                                Margin="6,0,0,6"
                                                Content="Internet Not Working"
                                                Click="LexDeskProblemInternet_Click"/>

                                        <Button x:Name="LexDeskProblemSoundButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Height="42"
                                                Margin="0,6,6,0"
                                                Content="No Sound"
                                                Click="LexDeskProblemSound_Click"/>

                                        <Button x:Name="LexDeskProblemPrinterButton"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Height="42"
                                                Margin="6,6,0,0"
                                                Content="Printer Not Working"
                                                Click="LexDeskProblemPrinter_Click"/>
                                    </UniformGrid>

                                    <Border Background="{DynamicResource ButtonBg}"
                                            BorderBrush="{DynamicResource ButtonBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LexDeskProblemSolverTitleText"
                                                       Text="Ready to help"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBlock x:Name="LexDeskProblemSolverStatusText"
                                                       Text="Choose the problem that best matches what is happening."
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,5,0,0"/>

                                            <!-- Stage 6: individual diagnostic lines use their own green/orange/red status. -->
                                            <StackPanel x:Name="LexDeskProblemSolverDetailPanel"
                                                        Visibility="Collapsed"
                                                        Margin="0,8,0,0"/>

                                            <ProgressBar x:Name="LexDeskProblemSolverProgressBar"
                                                         Height="6"
                                                         IsIndeterminate="True"
                                                         Visibility="Collapsed"
                                                         Margin="0,10,0,0"/>

                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="LexDeskProblemSafeFixButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="132"
                                                        Margin="0,0,8,8"
                                                        Content="Safe Fix"
                                                        IsEnabled="False"
                                                        Click="LexDeskProblemSafeFix_Click"/>

                                                <Button x:Name="LexDeskProblemOpenSettingsButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="132"
                                                        Margin="0,0,8,8"
                                                        Content="Open Settings"
                                                        IsEnabled="False"
                                                        Click="LexDeskProblemOpenSettings_Click"/>

                                                <Button x:Name="LexDeskProblemCheckAgainButton"
                                                        Style="{StaticResource TopBarButtonStyle}"
                                                        Height="36"
                                                        MinWidth="112"
                                                        Margin="0,0,0,8"
                                                        Content="Check Again"
                                                        IsEnabled="False"
                                                        Click="LexDeskProblemCheckAgain_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="LexDesk does not clear print jobs, reset your whole network, remove drivers, or disable startup apps by itself."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick actions strip -->
                            <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.2"
                        CornerRadius="16"
                        Padding="18"
                        Margin="8,0,8,0">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Quick start"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,6"/>

                                        <TextBlock Text="Open your browser workspace, return to Quick URL 1, or use the bottom dock for everyday apps."
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                Style="{StaticResource TopBarButtonStyle}"
                                MinWidth="140"
                                Height="36"
                                Margin="18,0,0,0"
                                Content="Open Quick URL 1"
                                Click="LexDeskHomeQuickUrl1_Click"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- LEXDESK PRO APPS / START MENU PANEL -->
            <!-- ===================================================== -->
            <Grid x:Name="LexDeskAppsPanel"
      Visibility="Collapsed"
      Panel.ZIndex="720"
      Background="{DynamicResource TopBarBg}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0"
              Margin="28,22,28,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Assets/Icons/lexdeskproicon.png"
                   Width="42"
                   Height="42"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,14,0"/>

                        <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                            <TextBlock Text="Apps"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Text="Everyday apps from your Windows Start Menu."
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                    x:Name="LexDeskAppsCloseButton"
                    Style="{StaticResource TopBarIconButtonStyle}"
                    Width="34"
                    Height="28"
                    ToolTip="Close Apps"
                    Click="LexDeskAppsClose_Click">

                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource TextPrimary}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M3,3 L13,13 M13,3 L3,13"/>
                        </Button>
                    </Grid>

                    <!-- Apps list -->
                    <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                        <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="24,18,24,44"
                        MaxWidth="980">

                            <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.2"
                        CornerRadius="18"
                        Padding="18"
                        Margin="8,0,8,18">

                                <StackPanel>
                                    <TextBlock Text="Apps"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                                    <TextBlock Text="Type to search, or click an app below to open it."
           FontSize="13"
           Foreground="{DynamicResource TextSecondary}"
           HorizontalAlignment="Center"
           Margin="0,0,0,10"/>

                                    <Border Width="360"
        Height="34"
        CornerRadius="15"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource CardBorder}"
        Background="{DynamicResource InputBg}"
        HorizontalAlignment="Center"
        Margin="0,0,0,14">

                                        <TextBox x:Name="LexDeskAppsSearchBox"
             BorderThickness="0"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimary}"
             CaretBrush="{DynamicResource TextPrimary}"
             FontSize="13"
             VerticalContentAlignment="Center"
             Padding="12,0"
             ToolTip="Search apps"
             TextChanged="LexDeskAppsSearchBox_TextChanged"/>
                                    </Border>

                                    <Border Height="1"
        Background="{DynamicResource CardBorder}"
        Margin="22,0,22,16"
        Opacity="0.65"/>
                                    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,14">


                                        <Button x:Name="LexDeskShowHiddenAppsButton"
            Content="Show hidden apps"
            Style="{StaticResource TopBarButtonStyle}"
            Width="170"
            Height="32"
            Visibility="Collapsed"
            ToolTip="Show or hide apps you have hidden from LexDesk"
            Click="LexDeskShowHiddenApps_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="LexDeskMostUsedSection"
            Visibility="Collapsed"
            Margin="0,0,0,16">

                                        <TextBlock Text="Most Used"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimary}"
               HorizontalAlignment="Center"
               Margin="0,0,0,8"/>

                                        <WrapPanel x:Name="LexDeskMostUsedPanel"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"/>
                                    </StackPanel>

                                    <Border Height="1"
        Background="{DynamicResource CardBorder}"
        Margin="22,0,22,16"
        Opacity="0.65"/>

                                    <StackPanel x:Name="LexDeskAppsSection"
            Margin="0,0,0,16">

                                        <TextBlock Text="Apps"
               FontSize="14"
               FontWeight="SemiBold"
