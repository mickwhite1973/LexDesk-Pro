Padding="12,0"
ToolTip="Left-click to open. Right-click to rename."
Click="LexDeskBubbleSocial_Click"
PreviewMouseRightButtonUp="LexDeskBubbleSocial_PreviewMouseRightButtonUp"/>

                        <Button x:Name="LexDeskBubblePersonalButton"
Content="Personal"
Style="{StaticResource TopBarButtonStyle}"
MinWidth="90"
MaxWidth="132"
Height="32"
Margin="4,0"
Padding="12,0"
ToolTip="Left-click to open. Right-click to rename."
Click="LexDeskBubblePersonal_Click"
PreviewMouseRightButtonUp="LexDeskBubblePersonal_PreviewMouseRightButtonUp"/>

                        <Button x:Name="LexDeskDockExplorerButton"
            Width="34"
            Height="34"
            Margin="2,-3,2,0"
            Padding="0"
            ToolTip="File Explorer"
            Style="{StaticResource TopBarIconButtonStyle}"
            Click="LexDeskOpenExplorer_Click">

                            <Image Source="/Assets/Icons/explorer.png"
       Width="22"
       Height="22"
       Stretch="Uniform"
       SnapsToDevicePixels="True"
       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="LexDeskDockDownloadsButton"
            Width="34"
            Height="34"
            Margin="2,-3,2,0"
            Padding="0"
            ToolTip="Downloads"
            Style="{StaticResource TopBarIconButtonStyle}"
            Click="LexDeskOpenDownloads_Click">

                            <Image Source="/Assets/Icons/downloads.png"
       Width="26"
       Height="26"
       Stretch="Uniform"
       SnapsToDevicePixels="True"
       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="LexDeskDockNotepadButton"
            Width="34"
            Height="34"
            Margin="2,-3,2,0"
            Padding="0"
            ToolTip="Notepad"
            Style="{StaticResource TopBarIconButtonStyle}"
            Click="LexDeskOpenNotepad_Click">

                            <Image Source="/Assets/Icons/notepad.png"
       Width="22"
       Height="22"
       Stretch="Uniform"
       SnapsToDevicePixels="True"
       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="LexDeskDockCalculatorButton"
            Width="34"
            Height="34"
            Margin="2,-3,2,0"
            Padding="0"
            ToolTip="Calculator"
            Style="{StaticResource TopBarIconButtonStyle}"
            Click="LexDeskOpenCalculator_Click">

                            <Image Source="/Assets/Icons/calculator.png"
       Width="22"
       Height="22"
       Stretch="Uniform"
       SnapsToDevicePixels="True"
       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="LexDeskDockSettingsButton"
        Width="34"
        Height="34"
        Margin="2,-3,2,0"
        Padding="0"
        ToolTip="Windows Settings"
        Style="{StaticResource TopBarIconButtonStyle}"
        Click="LexDeskOpenAppSettings_Click">

                            <Image Source="/Assets/Icons/settings.png"
               Width="22"
               Height="22"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="LexDeskBubbleDocsButton"
        Content="Docs"
        Style="{StaticResource TopBarButtonStyle}"
        MinWidth="76"
        MaxWidth="132"
        Height="32"
        Margin="4,0"
        Padding="12,0"
        ToolTip="Left-click to open. Right-click to rename."
        Click="LexDeskBubbleDocs_Click"
        PreviewMouseRightButtonUp="LexDeskBubbleDocs_PreviewMouseRightButtonUp"/>

                        <Button x:Name="LexDeskBubbleMusicButton"
        Content="Music"
        Style="{StaticResource TopBarButtonStyle}"
        MinWidth="76"
        MaxWidth="132"
        Height="32"
        Margin="4,0"
        Padding="12,0"
        ToolTip="Left-click to open. Right-click to rename."
        Click="LexDeskBubbleMusic_Click"
        PreviewMouseRightButtonUp="LexDeskBubbleMusic_PreviewMouseRightButtonUp"/>

                        <Button x:Name="LexDeskDockDesktopButton"
                                Width="38"
                                Height="38"
                                Margin="2,-3,2,0"
                                Padding="0"
                                ToolTip="Desktop"
                                Style="{StaticResource TopBarIconButtonStyle}"
                                Click="LexDeskOpenDesktop_Click">
                            <Image Source="/Assets/Icons/desktop.png"
       Width="26"
       Height="26"
       Stretch="Uniform"
       SnapsToDevicePixels="True"
       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- RIGHT: tray area -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="LexDeskTrayArrowButton"
        Width="30"
        Height="34"
        Margin="0,0,4,0"
        Padding="0"
        ToolTip="Hidden icons"
        Style="{StaticResource TopBarIconButtonStyle}"
        Click="LexDeskTrayArrowButton_Click">

                        <Path Style="{StaticResource VectorIconStyle}"
      Width="16"
      Height="16"
      StrokeThickness="1.8"
      Data="M4,11 L9,6 L14,11"/>
                    </Button>

                    <Popup x:Name="LexDeskTrayPopup"
                           PlacementTarget="{Binding ElementName=LexDeskTrayArrowButton}"
                           Placement="Top"
                           VerticalOffset="-6"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">

                        <Border Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1.4"
                                CornerRadius="14"
                                Padding="12"
                                MinWidth="190"
                                Margin="0,0,0,8">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Opacity="0.22"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock Text="LexDesk tray"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="4,0,4,8"/>

                                <Button Content="Network settings"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskWifiButton_Click"/>

                                <Button Content="Sound settings"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskSoundButton_Click"/>

                                <Button x:Name="LexDeskBatteryMenuButton"
                                        Content="Power settings"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskBatteryButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="LexDeskWifiButton"
        Width="34"
        Height="34"
        Margin="0,0,2,0"
        Padding="0"
        ToolTip="Network"
        Style="{StaticResource TopBarIconButtonStyle}"
        Click="LexDeskWifiButton_Click">

                        <Path Style="{StaticResource VectorIconStyle}"
      Width="16"
      Height="16"
      StrokeThickness="1.7"
      Data="M2,7
            C5.8,3.5 12.2,3.5 16,7
            M4.5,9.5
            C7,7.2 11,7.2 13.5,9.5
            M7,12
            C8.2,10.9 9.8,10.9 11,12
            M9,14 L9,14.1"/>
                    </Button>

                    <Button x:Name="LexDeskSoundButton"
        Width="34"
        Height="34"
        Margin="0,0,2,0"
        Padding="0"
        ToolTip="Sound"
        Style="{StaticResource TopBarIconButtonStyle}"
        Click="LexDeskSoundButton_Click">

                        <Path Style="{StaticResource VectorIconStyle}"
      Width="16"
      Height="16"
      StrokeThickness="1.7"
      Data="M3,7 L6,7 L10,4 L10,14 L6,11 L3,11 Z
            M12,7
            C13.5,8.5 13.5,10.5 12,12
            M14,5
            C17,8 17,11 14,14"/>
                    </Button>

                    <Button x:Name="LexDeskBatteryButton"
        Height="34"
        MinWidth="56"
        Margin="0,0,4,0"
        Padding="6,0"
        ToolTip="Battery"
        Visibility="Collapsed"
        Style="{StaticResource TopBarButtonStyle}"
        Click="LexDeskBatteryButton_Click">

                        <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                            <Path Style="{StaticResource VectorIconStyle}"
      Width="17"
      Height="17"
      StrokeThickness="1.7"
      Margin="0,0,4,0"
      Data="M3,5 L13,5 L13,13 L3,13 Z
            M13,7 L15,7 L15,11 L13,11
            M5,7 L9,7 L9,11 L5,11 Z"/>

                            <TextBlock x:Name="LexDeskBatteryPercentText"
                   Text=""
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- LexDesk Power -->
                    <Button x:Name="LexDeskPowerButton"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,0"
                            Padding="0"
                            ToolTip="Power"
                            Style="{StaticResource TopBarIconButtonStyle}"
                            Click="LexDeskPowerButton_Click">

                        <Path Style="{StaticResource VectorIconStyle}"
                              Width="18"
                              Height="18"
                              StrokeThickness="1.8"
                              Stroke="{DynamicResource SettingsNavAccent}"
                              Data="M9,2 L9,9
                                    M5.2,4.6
                                    A6,6 0 1 0 12.8,4.6"/>
                    </Button>

                    <Popup x:Name="LexDeskPowerPopup"
                           PlacementTarget="{Binding ElementName=LexDeskPowerButton}"
                           Placement="Top"
                           VerticalOffset="-6"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">

                        <Border Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1.4"
                                CornerRadius="14"
                                Padding="12"
                                MinWidth="210"
                                Margin="0,0,0,8">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Opacity="0.22"/>
                            </Border.Effect>

                            <StackPanel>

                                <TextBlock Text="Power"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="4,0,4,8"/>

                                <Button Content="Lock PC"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskLockPc_Click"/>

                                <Button Content="Sleep"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskSleepPc_Click"/>

                                <Button Content="Sign Out"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskSignOutPc_Click"/>

                                <Separator Margin="6,8,6,8"/>

                                <Button Content="Restart PC"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskRestartPc_Click"/>

                                <Button Content="Shut Down PC"
                                        Style="{StaticResource MainMenuListButtonStyle}"
                                        Click="LexDeskShutdownPc_Click"/>

                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="LexDeskClockButton"
                            Width="96"
                            Height="36"
                            Margin="2,-3,0,0"
                            Padding="4,0"
                            ToolTip="Calendar"
                            Style="{StaticResource TopBarButtonStyle}"
                            Click="LexDeskClockButton_Click">

                        <StackPanel Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

                            <Path Style="{StaticResource VectorIconStyle}"
      Width="18"
      Height="18"
      StrokeThickness="1.7"
      Margin="0,0,5,0"
      Data="M4,4 L14,4 L14,15 L4,15 Z
            M4,7 L14,7
            M6,2 L6,5
            M12,2 L12,5
            M7,10 L8,10
            M10,10 L11,10
            M7,12.5 L8,12.5
            M10,12.5 L11,12.5"/>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LexDeskClockTimeText"
                   Text="--:--"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

                                <TextBlock x:Name="LexDeskClockDateText"
                   Text="--/--/----"
                   FontSize="10"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Popup x:Name="LexDeskCalendarPopup"
       PlacementTarget="{Binding ElementName=LexDeskClockButton}"
       Placement="Top"
       VerticalOffset="-6"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False">

                        <Border Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1.4"
            CornerRadius="16"
            Padding="14"
            Margin="0,0,0,8"
            Width="610"
            Height="390">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.25"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CALENDAR -->
                                <StackPanel Grid.Column="0"
                        Margin="0,0,14,0">

                                    <TextBlock Text="Calendar"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="4,0,0,10"/>

                                    <Calendar x:Name="LexDeskCalendar"
                          IsTodayHighlighted="True"
                          SelectedDatesChanged="LexDeskCalendar_SelectedDatesChanged"/>
                                </StackPanel>

                                <!-- DIVIDER -->
                                <Border Grid.Column="1"
                    Background="{DynamicResource CardBorder}"
                    Margin="0,4"/>

                                <!-- EVENTS -->
                                <Grid Grid.Column="2"
                  Margin="14,0,0,0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                            Margin="0,0,0,10">

                                        <TextBlock Text="Events"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                                        <TextBlock x:Name="LexDeskCalendarSelectedDateText"
                               Text="Today"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                                        <StackPanel x:Name="LexDeskCalendarEventsPanel"/>
                                    </ScrollViewer>

                                    <Grid Grid.Row="2"
      Margin="0,10,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
            x:Name="LexDeskCalendarNotificationButton"
            Content="Reminders Off - Turn On"
            Style="{StaticResource TopBarButtonStyle}"
            Height="34"
            MinWidth="160"
            HorizontalAlignment="Left"
            Visibility="Collapsed"
            Click="LexDeskCalendarNotificationButton_Click"/>

                                        <Button Grid.Column="1"
            x:Name="LexDeskCalendarAddEventButton"
            Content="+ Add Event"
            Style="{StaticResource TopBarButtonStyle}"
            Height="34"
            MinWidth="110"
            HorizontalAlignment="Right"
            Margin="10,0,0,0"
            Click="LexDeskCalendarAddEvent_Click"/>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
