                                            <TextBlock Text="Share this page includes Copy Link, Copy Title and Link, Share by Email, X / Twitter, Facebook, LinkedIn, and WhatsApp Web."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="You can also clear cookies for the current site or clear all cookies. Clearing cookies may sign you out of websites."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Use Smart Compatibility"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Click the Compatibility icon when a trusted website does not load correctly."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="This saves the current trusted website to the Compatibility List and allows login, media and essential site functions while keeping safer ad/tracker blocking where possible."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="When the Compatibility button is orange, click it to open the Compatibility List. You can remove one site or clear the list."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Open Privacy controls"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Click Privacy to change privacy mode, manage allow lists, update the Block List, delete history, or use privacy network controls."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

