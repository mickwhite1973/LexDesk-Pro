                                             Width="4"
                                             Height="4"
                                             Fill="{DynamicResource FeatureToolsBrush}"/>

                                    <Ellipse Canvas.Left="11"
                                             Canvas.Top="8"
                                             Width="4"
                                             Height="4"
                                             Fill="{DynamicResource FeatureToolsBrush}"/>

                                    <Ellipse Canvas.Left="5"
                                             Canvas.Top="13"
                                             Width="4"
                                             Height="4"
                                             Fill="{DynamicResource FeatureToolsBrush}"/>

                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="SettingsButton"
        Visibility="Collapsed"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        MinWidth="{DynamicResource TopBarButtonWidth}"
        Padding="0"
        Margin="3,0,0,0"
        ToolTip="Settings&#x0a;Left click: Open app settings"
        Click="SettingsButton_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="6" Height="6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Path Data="M10 3 V1.8 M10 18.2 V17 M3 10 H1.8 M18.2 10 H17 M5 5 L4.1 4.1 M15.9 15.9 L15 15 M5 15 L4.1 15.9 M15.9 4.1 L15 5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Stage 4B: optional AI quick-access menu -->
                        <Button x:Name="AiTopButton"
        Visibility="Collapsed"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        MinWidth="{DynamicResource TopBarButtonWidth}"
        Padding="0"
        Margin="3,0,0,0"
        ToolTip="AI quick access"
        Click="AiTopButton_Click">
                            <TextBlock Text="AI"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource IconBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Popup x:Name="AiQuickAccessPopup"
                               PlacementTarget="{Binding ElementName=AiTopButton}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    MinWidth="230"
                                    Margin="0,6,0,0"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="AI Quick Access"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="4,0,4,4"/>
                                    <TextBlock Text="Open an AI service in the active page."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="4,0,4,10"/>

                                    <Button x:Name="AiChatGptMenuButton" Style="{StaticResource TopBarButtonStyle}" Content="ChatGPT" Tag="https://chatgpt.com/" Margin="0,0,0,5" Click="AiShortcutButton_Click"/>
                                    <Button x:Name="AiClaudeMenuButton" Style="{StaticResource TopBarButtonStyle}" Content="Claude" Tag="https://claude.ai/" Margin="0,0,0,5" Click="AiShortcutButton_Click"/>
                                    <Button x:Name="AiGeminiMenuButton" Style="{StaticResource TopBarButtonStyle}" Content="Gemini" Tag="https://gemini.google.com/" Margin="0,0,0,5" Click="AiShortcutButton_Click"/>
                                    <Button x:Name="AiPerplexityMenuButton" Style="{StaticResource TopBarButtonStyle}" Content="Perplexity" Tag="https://www.perplexity.ai/" Margin="0,0,0,5" Click="AiShortcutButton_Click"/>
                                    <Button x:Name="AiCopilotMenuButton" Style="{StaticResource TopBarButtonStyle}" Content="Microsoft Copilot" Tag="https://copilot.microsoft.com/" Margin="0,0,0,5" Click="AiShortcutButton_Click"/>
                                    <Button x:Name="AiGrokMenuButton" Style="{StaticResource TopBarButtonStyle}" Content="Grok" Tag="https://grok.com/" Margin="0,0,0,5" Click="AiShortcutButton_Click"/>
                                    <Button x:Name="AiDeepSeekMenuButton" Style="{StaticResource TopBarButtonStyle}" Content="DeepSeek" Tag="https://chat.deepseek.com/" Margin="0,0,0,5" Click="AiShortcutButton_Click"/>

                                    <TextBlock x:Name="AiNoServicesText"
                                               Text="No AI services selected."
                                               Visibility="Collapsed"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextAlignment="Center"
                                               Margin="4,8,4,8"/>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="4,7,4,10"/>
                                    <Button Style="{StaticResource TopBarButtonStyle}"
                                            Content="Manage AI shortcuts..."
                                            Click="AiManageShortcuts_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button x:Name="PrivacyButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        MinWidth="{DynamicResource TopBarButtonWidth}"
        Padding="0"
        Margin="3,0,0,0"
        ToolTip="Privacy tools&#x0a;Left click: Open privacy controls"
        Click="PrivacyButton_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Path Data="M10 2.8 L16 5.2 V9.7 C16 13.4 13.6 16.2 10 17.5 C6.4 16.2 4 13.4 4 9.7 V5.2 Z" Stroke="{DynamicResource FeaturePrivacyBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Path Data="M7.2 10 L9.2 12 L13 8.2" Stroke="{DynamicResource FeaturePrivacyBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Appears only when a LexDesk Pro update is available. -->
                        <Button x:Name="ToolbarUpdateButton"
                                Visibility="Collapsed"
                                Style="{StaticResource TopBarIconButtonStyle}"
                                Width="{DynamicResource TopBarButtonWidth}"
                                Height="{DynamicResource TopBarButtonHeight}"
                                MinWidth="{DynamicResource TopBarButtonWidth}"
                                Padding="0"
                                Margin="3,0,0,0"
                                ToolTip="Update available&#x0a;Click to update LexDesk Pro"
                                Click="UpdateAppButton_Click">
                            <Viewbox Width="18"
                                     Height="18"
                                     Stretch="Uniform">
                                <Canvas Width="20"
                                        Height="20">

                                    <!-- Download arrow -->
                                    <Path Data="M10 3 V12 M6.5 8.5 L10 12 L13.5 8.5"
                                          Stroke="#FF4696FF"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>

                                    <!-- Download tray -->
                                    <Path Data="M4 14 V16.5 H16 V14"
                                          Stroke="#FF4696FF"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="MainMenuButton"
Style="{StaticResource TopBarIconButtonStyle}"
ToolTip="Menu"
Click="MainMenuButton_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Canvas.Left="9" Canvas.Top="4" Width="2" Height="2" Fill="{DynamicResource IconBrush}"/>
                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="2" Height="2" Fill="{DynamicResource IconBrush}"/>
                                    <Ellipse Canvas.Left="9" Canvas.Top="14" Width="2" Height="2" Fill="{DynamicResource IconBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="StartupOverlayTopButton"
Style="{StaticResource TopBarIconButtonStyle}"
Width="{DynamicResource TopBarButtonWidth}"
Height="{DynamicResource TopBarButtonHeight}"
ToolTip="Startup Screen&#x0a;Left click: Show the Startup Screen&#x0a;On the Startup Screen, right-click to add or change the image"
Visibility="Collapsed"
Click="StartupOverlayTopButton_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="14" Height="11" RadiusX="1.5" RadiusY="1.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Path Data="M6 13 L9 10 L11 12 L13 9 L16 13" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="6" Canvas.Top="7" Width="2" Height="2" Fill="{DynamicResource IconBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Popup x:Name="WebActionsDropdown"
       PlacementTarget="{Binding ElementName=MainContentHost}"
       Placement="Center"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False">

                            <Popup.Resources>
                                <Style x:Key="ToolsCardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TopBarButtonStyle}">
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </Popup.Resources>

                            <Border Width="1080"
            Height="710"
            Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1.4"
            CornerRadius="16"
            Padding="22"
            SnapsToDevicePixels="True">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Tools"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBlock Text="Everyday page tools grouped by what you want to do. Nothing here changes your normal privacy settings unless clearly stated."
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                        Width="30"
                        Height="26"
                        Margin="16,0,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource TopBarIconButtonStyle}"
                        ToolTip="Close Tools"
                        Click="WebActionsClose_Click">

                                            <Viewbox Width="16" Height="16">
                                                <Path Data="M4 4 L12 12 M12 4 L4 12"
                              Stroke="{DynamicResource IconBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>

                                    <!-- Tool groups -->
                                    <Grid Grid.Row="1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Browse & Read -->
                                        <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="0.8"
                        CornerRadius="10"
                        Padding="16">

                                            <StackPanel>
                                                <TextBlock Text="Browse &amp; Read"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Text="Find information on the current page or simplify a long article for easier reading."
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                Content="Find on Page   Ctrl+F"
                                Click="WebAction_FindOnPage_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                Content="Reading View"
                                Click="WebAction_ReadingView_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Capture & Share -->
                                        <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="0.8"
                        CornerRadius="10"
                        Padding="16">

                                            <StackPanel>
                                                <TextBlock Text="Capture &amp; Share"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Text="Save what you can see, capture the whole page, print it, or share the current page."
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                                        Content="Visible Screenshot - Save PNG"
                                                        Click="WebAction_CapturePage_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                                        Content="Full Page Screenshot - Save PNG"
                                                        Click="WebAction_CaptureFullPage_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                                        Content="Capture Area - Windows Snipping Tool"
                                                        Click="WebAction_CaptureArea_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                                        Content="Record Screen - Windows Snipping Tool"
                                                        Click="WebAction_RecordScreen_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                                        Content="Print"
                                                        Click="WebAction_Print_Click"/>

                                                <Button x:Name="ShareButton"
                                Style="{StaticResource ToolsCardButtonStyle}"
                                Content="Share..."
                                Click="WebAction_Share_Click">

                                                    <Button.ContextMenu>
                                                        <ContextMenu x:Name="ShareMenu"
             Background="{DynamicResource CardBg}"
             Foreground="{DynamicResource TextPrimary}"
             BorderBrush="{DynamicResource CardBorder}">
                                                            <MenuItem Header="Copy Link"
                                              Click="ShareCopyLink_Click"/>

                                                            <MenuItem Header="Copy Title + Link"
                                              Click="ShareCopyTitleLink_Click"/>

                                                            <Separator/>

                                                            <MenuItem Header="Gmail Web"
                                              Click="ShareGmailWeb_Click"/>

                                                            <MenuItem Header="Email App"
                                              Click="ShareEmail_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Edit & Save -->
                                        <Border Grid.Row="0"
                        Grid.Column="4"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="0.8"
                        CornerRadius="10"
                        Padding="16">

                                            <StackPanel>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
            Content="ⓘ  Copying text"
            Click="WebAction_CopyingTextHelp_Click"
            Margin="0,0,0,10"/>

                                                <TextBlock Text="Edit &amp; Save"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Text="Work with selected text and save useful pages so they are easy to find again."
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                Content="Copy Selected Text"
                                Click="WebAction_CopySelection_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                Content="Cut Selected Text"
                                Click="WebAction_CutSelection_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                Content="Paste Text into Page"
                                Click="WebAction_PasteText_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
                                Content="Save as Favourite"
                                Click="WebAction_Bookmark_Click"/>

                                                <Button Style="{StaticResource ToolsCardButtonStyle}"
