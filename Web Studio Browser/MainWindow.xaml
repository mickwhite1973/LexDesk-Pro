                                    <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="Disk Management"
                    Height="40"
                    Margin="5,5,0,5"
                    Style="{StaticResource TopBarButtonStyle}"
                    Click="LexDeskPage2DiskManagement_Click"/>

                                    <Button Grid.Row="3"
                    Grid.Column="0"
                    Content="Task Scheduler"
                    Height="40"
                    Margin="0,5,5,5"
