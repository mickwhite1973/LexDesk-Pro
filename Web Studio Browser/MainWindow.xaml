<Window x:Class="Web_Studio_Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="LexDesk Pro"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBg}"
        MinWidth="1180"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Loaded="MainWindow_Loaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="8"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>



    <Window.Resources>

        <Style x:Key="VectorIconStyle" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Stroke"
            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- ============================================ -->
        <!-- [[APPEARANCE]] START: Shared theme brushes. Light/Dark runtime colours are applied by ApplyTheme(). -->
        <!-- ============================================ -->

        <sys:Double x:Key="TopBarIconSize">16</sys:Double>
        <sys:Double x:Key="TopBarButtonWidth">28</sys:Double>
        <sys:Double x:Key="TopBarButtonHeight">28</sys:Double>
        <sys:Double x:Key="TopBarCompactButtonWidth">25</sys:Double>
        <sys:Double x:Key="TopBarFontSize">12</sys:Double>
        <Thickness x:Key="TopBarGap">4,0,4,0</Thickness>
        <Thickness x:Key="TopBarLeftGap">4,0,0,0</Thickness>
        <sys:Double x:Key="AddressBarHeight">30</sys:Double>

        <SolidColorBrush x:Key="MenuButtonBrush" Color="#FF405066"/>
        <SolidColorBrush x:Key="BottomDockAccentBrush" Color="#FF6EA8E5"/>

        <!-- Core surfaces -->
        <SolidColorBrush x:Key="AppBg" Color="#FFF7F8FA"/>
        <SolidColorBrush x:Key="TopBarBg" Color="#FFF7F8FA"/>


        <!-- Controls -->
        <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#FFC1CBD8"/>
        <SolidColorBrush x:Key="ButtonHoverBg" Color="#FFE7EDF3"/>
        <SolidColorBrush x:Key="ButtonPressedBg" Color="#FFDDEAF5"/>

        <!-- Lines / borders -->
        <SolidColorBrush x:Key="DividerBrush" Color="#FFC7D0DC"/>
        <SolidColorBrush x:Key="SplitDividerBrush" Color="#FFD4DBE4"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimary" Color="#FF0A0F1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF405066"/>

        <!-- Cards / panels -->
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FFC7D0DC"/>

        <!-- Settings navigation surfaces -->
        <SolidColorBrush x:Key="SettingsNavHoverBg" Color="#FFE7EDF3"/>
        <SolidColorBrush x:Key="SettingsNavSelectedBg" Color="#FFDDEAF5"/>
        <SolidColorBrush x:Key="SettingsNavAccent" Color="#FF3EA6FF"/>

        <!-- Inputs -->
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="InputBorder" Color="#FF9BAABD"/>

        <!-- Icon / accent brushes -->

        <SolidColorBrush x:Key="IconBrush" Color="#FF405066"/>
        <SolidColorBrush x:Key="IconBrushMuted" Color="#FF596A80"/>

        <!-- Restrained colour accents reserved for LexDesk Pro-specific toolbar features. -->
        <SolidColorBrush x:Key="FeaturePrivacyBrush" Color="#FF8B7CF6"/>
        <SolidColorBrush x:Key="FeatureFavouritesBrush" Color="#FFD4A84F"/>
        <SolidColorBrush x:Key="FeatureEmergencyBrush" Color="#FFD96B6B"/>
        <SolidColorBrush x:Key="FeatureCyclePagesBrush" Color="#FF7C83E6"/>
        <SolidColorBrush x:Key="FeatureToolsBrush" Color="#FF6EA8E5"/>

        <!-- Caption controls stay neutral by default; Close uses a restrained Windows-style red hover. -->
        <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#FFC42B1C"/>
        <SolidColorBrush x:Key="CaptionCloseHoverForegroundBrush" Color="#FFFFFFFF"/>

        <SolidColorBrush x:Key="PrivacyOffBrush" Color="#FFE0A23A"/>
        <SolidColorBrush x:Key="PrivacyOnBrush" Color="#FF5FB37C"/>
        <SolidColorBrush x:Key="LightningBrush" Color="#FFF2B23C"/>

        <SolidColorBrush x:Key="StatusGreenBrush" Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="StatusOrangeBrush" Color="#FFF0A43A"/>
        <SolidColorBrush x:Key="StatusRedBrush" Color="#FFE05454"/>

        <!-- Legacy dark-theme brush keys retained for older styles; the active Light/Dark palette is now applied at runtime by ApplyTheme(). -->
        <SolidColorBrush x:Key="IconBrushDark" Color="#FFF7F4EE"/>
        <SolidColorBrush x:Key="IconBrushMutedDark" Color="#FFE2D8CB"/>
        <SolidColorBrush x:Key="HoverBrushDark" Color="#FF2B3442"/>
        <SolidColorBrush x:Key="PressedBrushDark" Color="#FF394557"/>

        <SolidColorBrush x:Key="AppBgDark" Color="#FF11161D"/>
        <SolidColorBrush x:Key="TopBarBgDark" Color="#FF161C24"/>

        <SolidColorBrush x:Key="ButtonBgDark" Color="#FF1B2430"/>
        <SolidColorBrush x:Key="ButtonBorderDark" Color="#FF334155"/>
        <SolidColorBrush x:Key="ButtonHoverBgDark" Color="#FF1F2937"/>
        <SolidColorBrush x:Key="ButtonPressedBgDark" Color="#FF273244"/>

        <SolidColorBrush x:Key="DividerBrushDark" Color="#FF232D3A"/>

        <SolidColorBrush x:Key="TextPrimaryDark" Color="#FFF7F4EE"/>
        <SolidColorBrush x:Key="TextSecondaryDark" Color="#FFD5CBBE"/>

        <SolidColorBrush x:Key="CardBgDark" Color="#FF1A212B"/>
        <SolidColorBrush x:Key="CardBorderDark" Color="#FF334155"/>

        <SolidColorBrush x:Key="InputBgDark" Color="#FF0F141B"/>
        <SolidColorBrush x:Key="InputBorderDark" Color="#FF4D627C"/>

        <SolidColorBrush x:Key="AppBgGlass" Color="#FFF2F6FB"/>
        <SolidColorBrush x:Key="TopBarBgGlass" Color="#E6F7FBFF"/>

        <SolidColorBrush x:Key="ButtonBgGlass" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderGlass" Color="#99AFC4D8"/>
        <SolidColorBrush x:Key="ButtonHoverBgGlass" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="ButtonPressedBgGlass" Color="#CCDCEAF7"/>

        <SolidColorBrush x:Key="DividerBrushGlass" Color="#99C7D6E5"/>

        <SolidColorBrush x:Key="TextPrimaryGlass" Color="#FF1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryGlass" Color="#FF5F6F82"/>

        <SolidColorBrush x:Key="CardBgGlass" Color="#D9FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderGlass" Color="#99B8CADB"/>

        <SolidColorBrush x:Key="InputBgGlass" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="InputBorderGlass" Color="#99AFC4D8"/>

        <SolidColorBrush x:Key="IconBrushGlass" Color="#FF2B3B4D"/>
        <SolidColorBrush x:Key="IconBrushMutedGlass" Color="#FF66788C"/>

        <SolidColorBrush x:Key="SelectedButtonBorder" Color="#FF17689F"/>

        <!-- ============================================ -->
        <!-- [[APPEARANCE]] END: Shared theme brushes -->
        <!-- ============================================ -->

        <!-- Rounded top bar button style -->
        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lower toolbar Edge-style + tab button -->
        <Style x:Key="LowerTabPlusButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource TopBarButtonWidth}"/>
            <Setter Property="Height" Value="{DynamicResource TopBarButtonHeight}"/>
            <Setter Property="Margin" Value="{DynamicResource TopBarLeftGap}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="{DynamicResource TopBarFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,-2,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="Root"
                                Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="11"
                                                  ShadowDepth="0"
                                                  Opacity="0.34"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>

                            <!-- Keep Minimise/Maximise neutral. Close only turns red while hovered, matching familiar Windows browser behaviour. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="CloseCaption"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource CaptionCloseHoverBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource CaptionCloseHoverForegroundBrush}"/>
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                Property="Opacity"
                                Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brave-style three-lines menu button -->
        <Style x:Key="HamburgerMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource TopBarButtonWidth}"/>
            <Setter Property="Height" Value="{DynamicResource TopBarButtonHeight}"/>
            <Setter Property="Margin" Value="{DynamicResource TopBarLeftGap}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">

                            <Grid Width="18" Height="14"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                                <Path Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2 2 L16 2"/>
                                <Path Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2 7 L16 7"/>
                                <Path Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2 12 L16 12"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="Root"
                                Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.36"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons inside the main menu dropdown -->
        <Style x:Key="MainMenuListButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern left-side Settings navigation -->
        <Style x:Key="SettingsNavButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <Border x:Name="Accent"
                                        Width="3"
                                        Margin="3,8,0,8"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SettingsNavAccent}"
                                        CornerRadius="2"
                                        Visibility="Collapsed"/>

                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource SettingsNavHoverBg}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource SettingsNavSelectedBg}"/>
                            </Trigger>

                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource SettingsNavSelectedBg}"/>
                                <Setter TargetName="Accent"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Modern Settings toggle switch -->
        <Style x:Key="SettingsToggleSwitchStyle"
               TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    Background="{DynamicResource ButtonBorder}"
                                    CornerRadius="12"/>

                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource InputBg}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="{DynamicResource SelectedButtonBorder}"/>
                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="Thumb"
                                        Property="Margin"
                                        Value="0,0,3,0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track"
                                        Property="Opacity"
                                        Value="0.45"/>
                                <Setter TargetName="Thumb"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless top bar icon button style -->
        <Style x:Key="TopBarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource TopBarButtonWidth}"/>
            <Setter Property="Height" Value="{DynamicResource TopBarButtonHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource TopBarFontSize}"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                Property="Opacity"
                                Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="2.0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="2.0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle icon button (for shield) to match the rest -->
        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="2.0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Guide / overlay expander headers -->
        <Style TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Chrome/Edge-style two-row browser toolbar -->
            <RowDefinition Height="Auto"/>

            <!-- Browser content -->
            <RowDefinition Height="*"/>

            <!-- LexDesk Pro bottom dock / taskbar -->
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
        Background="{DynamicResource TopBarBg}"
        BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="0"
        Padding="8,6,4,5"
        shell:WindowChrome.IsHitTestVisibleInChrome="True"
        MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: tab strip -->
                    <RowDefinition Height="Auto"/>

                    <!-- Row 1: browser toolbar -->
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{DynamicResource TopBarBg}"
                      VerticalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- WORKSPACE TABS + OPTIONAL LEFT UTILITIES -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">

                        <Border x:Name="WorkspaceTabsHost"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="0"
        Padding="0"
        Margin="4,0,0,0"
        MinWidth="0"
        MaxWidth="270">

                            <StackPanel x:Name="WorkspaceTabsPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                                <!-- Tab buttons are created in C# by RebuildWorkspaceTabs(). -->
                            </StackPanel>
                        </Border>

                        <Button x:Name="BackToWindowsButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Margin="6,0,0,0"
        ToolTip="Back to Windows&#x0a;Minimise LexDesk Pro"
        Click="WinMin_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="6" Height="6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="3" Width="6" Height="6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="11" Width="6" Height="6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="11" Width="6" Height="6" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="ThemesButton"
Style="{StaticResource TopBarIconButtonStyle}"
ToolTip="Theme&#x0a;Left click: Change app theme"
Visibility="Collapsed"
Click="ThemesButton_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Canvas.Left="6" Canvas.Top="6" Width="8" Height="8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Path Data="M10 2 V4 M10 16 V18 M2 10 H4 M16 10 H18 M4.3 4.3 L5.7 5.7 M14.3 14.3 L15.7 15.7 M4.3 15.7 L5.7 14.3 M14.3 5.7 L15.7 4.3" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="GuideButton"
Style="{StaticResource TopBarButtonStyle}"
Content="📘 Guide"
Height="28"
MinWidth="78"
Padding="12,0"
Margin="6,0,0,0"
ToolTip="Guide&#x0a;Left click: Open LexDesk Pro Guide"
Visibility="Collapsed"
Click="GuideButton_Click"/>

                        <Button x:Name="OpenQuarantineFolderButton"
Style="{StaticResource TopBarButtonStyle}"
Height="28"
MinWidth="118"
Padding="12,0"
Margin="6,0,0,0"
ToolTip="Open LexDesk Pro quarantine folder"
Visibility="Collapsed"
Click="OpenQuarantineFolderButton_Click"
Content="Quarantine"/>

                    </StackPanel>

                    <!-- APP CONTROLS -->
                    <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="10,0,0,0">

                        <Button x:Name="WinMinTopButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        ToolTip="Minimise"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Click="WinMin_Click"
        PreviewMouseRightButtonUp="WinMinTopButton_PreviewMouseRightButtonUp">
                            <Grid Width="18" Height="18">
                                <!-- Lifted slightly toward centre, closer to Edge/Windows caption placement. -->
                                <Path Data="M4 10.5 H14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                            </Grid>
                        </Button>

                        <Button x:Name="WinMaxTopButton"
Style="{StaticResource TopBarIconButtonStyle}"
ToolTip="Maximise / Restore app&#x0a;Right-click: Maximise active Web Page"
Width="{DynamicResource TopBarButtonWidth}"
Height="{DynamicResource TopBarButtonHeight}"
Click="WinMaxRestore_Click"
PreviewMouseRightButtonUp="WinMaxTopButton_PreviewMouseRightButtonUp">
                            <Grid Width="18" Height="18">
                                <!-- Fixed-size glyph so Maximise visually matches the Close X instead of being rescaled by a Viewbox. -->
                                <Rectangle Width="10" Height="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.2"
                                           Fill="Transparent"/>
                            </Grid>
                        </Button>

                        <Button x:Name="WinCloseTopButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Tag="CloseCaption"
        ToolTip="Close"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Click="WinClose_Click">
                            <Grid Width="18" Height="18">
                                <Path Data="M4 4 L14 14 M14 4 L4 14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                            </Grid>
                        </Button>

                        <Button x:Name="SecureFileReceiveCheckButton"
        Style="{StaticResource TopBarButtonStyle}"
        Height="28"
        MinWidth="86"
        Padding="12,0"
        Margin="6,0,0,0"
        ToolTip="Check File&#x0a;Scan a file before opening it"
        Visibility="Collapsed"
        Click="SecureFileReceiveCheckButton_Click"
        Content="Check File"/>

                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Popup host / zero-width utility column -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- Main browser controls + flexible address bar -->
                        <ColumnDefinition Width="*"/>

                        <!-- Optional tools / privacy / menu -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- POPUP HOSTS / LOWER-TOOLBAR UTILITY AREA -->
                    <StackPanel Grid.Column="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Left">







                        <!-- Legacy Settings popup host retained for existing open/close logic -->
                        <Popup x:Name="SettingsDropdown"
       PlacementTarget="{Binding ElementName=SettingsButton}"
       Placement="Bottom"
       HorizontalOffset="0"
       VerticalOffset="0"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False">
                            <Border Background="{DynamicResource TopBarBg}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1.4"
            CornerRadius="16"
            Padding="14"
            Margin="0,6,0,0"
            SnapsToDevicePixels="True">
                                <StackPanel/>
                            </Border>
                        </Popup>


                        <Popup x:Name="PrivacyDropdown"
       PlacementTarget="{Binding ElementName=MainContentHost}"
       Placement="Center"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False">
                            <!-- Legacy popup host retained because older open/close and responsive code
                                 still references PrivacyDropdown/PrivacyPopupCard. Privacy controls now
                                 live together on Settings > Privacy & Safety. -->
                            <Border x:Name="PrivacyPopupCard"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1.4"
                                    CornerRadius="16"
                                    Padding="18"
                                    MinWidth="420"
                                    Visibility="Collapsed">
                                <StackPanel/>
                            </Border>
                        </Popup>

                    </StackPanel>

                    <!-- CENTER -->
                    <Grid x:Name="CenterToolbarHost"
      Grid.Column="1"
      VerticalAlignment="Center"
      Margin="6,0,6,0">
                        <StackPanel x:Name="CenterToolbarPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">







                            <Button x:Name="SnapBackTopButton"
Visibility="Visible"
Style="{StaticResource TopBarButtonStyle}"
Content="Reopen"
ToolTip="Restore Closed Page&#x0a;Reopens the most recently closed Web Page"
Margin="3,0,3,0"
Padding="10,4"
Click="SnapBackTopButton_Click"/>

                            <Button x:Name="BackTopButton"
Style="{StaticResource TopBarIconButtonStyle}"
ToolTip="Back&#x0a;Left click: Go back in the active Web Page"
Click="BackTopButton_Click">
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <Path Data="M12.5 4.5 L7 10 L12.5 15.5 M7 10 H16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Viewbox>
                            </Button>

                            <Button x:Name="ForwardTopButton"
Style="{StaticResource TopBarIconButtonStyle}"
ToolTip="Forward&#x0a;Left click: Go forward in the active Web Page"
Click="ForwardTopButton_Click">
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <Path Data="M7.5 4.5 L13 10 L7.5 15.5 M13 10 H4" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Viewbox>
                            </Button>

                            <Button x:Name="ReloadButton"
Style="{StaticResource TopBarIconButtonStyle}"
ToolTip="Refresh&#x0a;Left click: Reload the active Web Page"
Click="ReloadButton_Click">
                                <Viewbox Width="18" Height="18" Stretch="Uniform"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <TranslateTransform Y="1"/>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M15.5 7.2 A6 6 0 1 0 16 11" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        <Path Data="M15.5 3.8 V7.5 H11.8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>


                            <Button x:Name="HomeTopButton"
Style="{StaticResource TopBarIconButtonStyle}"
ToolTip="Home&#x0a;Left click: Load Quick URL 1"
Click="HomeTopButton_Click">
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <Path Data="M4 9.5 L10 4 L16 9.5 V16 H12 V11.5 H8 V16 H4 Z" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Viewbox>
                            </Button>

                            <!-- Status dot -->
                            <Border x:Name="StatusIndicatorHost"
        Width="22"
        Height="22"
        Margin="0,0,10,0"
        Background="Transparent"
        CornerRadius="11"
        VerticalAlignment="Center"
        ToolTip="Status: Safe"
        Cursor="Hand"
        MouseLeftButtonUp="StatusIndicatorHost_MouseLeftButtonUp">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10"
                          ShadowDepth="0"
                          Opacity="0.85"/>
                                </Border.Effect>

                                <Ellipse x:Name="StatusIndicator"
             Width="10"
             Height="10"
             Fill="{DynamicResource StatusGreenBrush}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="12"
                              ShadowDepth="0"
                              Color="#FF4CAF50"
                              Opacity="0.9"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>

                            <Popup x:Name="StatusPopup"
       PlacementTarget="{Binding ElementName=StatusIndicatorHost}"
       Placement="Bottom"
       StaysOpen="False"
       AllowsTransparency="True"
       PopupAnimation="Fade">

                                <Border Background="{DynamicResource TopBarBg}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1.4"
            CornerRadius="16"
            Padding="16"
            Margin="0,6,0,0"
            SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.22"/>
                                    </Border.Effect>

                                    <StackPanel MinWidth="320"
                                            MaxWidth="420">

                                        <TextBlock Text="Security &amp; Privacy"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,4"/>

                                        <TextBlock x:Name="StatusPopupSummaryText"
                       Text="Browsing is protected"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Status"
                           Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupStateText"
                           Grid.Column="1"
                           Text="Safe"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Connection"
               Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupConnectionText"
               Grid.Column="1"
               Text="Secure"
               Foreground="{DynamicResource TextPrimary}"
               HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Reason"
               Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupReasonText"
               Grid.Column="1"
               Text="This page looks secure"
               Foreground="{DynamicResource TextPrimary}"
               HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Privacy Mode"
                           Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupPrivacyText"
                           Grid.Column="1"
                           Text="Recommended"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Trackers Blocked"
                           Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupTrackersText"
                           Grid.Column="1"
                           Text="0"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Ads Blocked"
                           Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupAdsText"
                           Grid.Column="1"
                           Text="0"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Compatibility"
                           Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupCompatibilityText"
                           Grid.Column="1"
                           Text="Off"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Active Web Page"
                           Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupPageText"
                           Grid.Column="1"
                           Text="1 of 4"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Border Height="1"
                    Background="{DynamicResource DividerBrush}"
                    Margin="0,8,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Update"
                           Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock x:Name="StatusPopupUpdateText"
           Grid.Column="1"
           Text="Up to date"
           Foreground="{DynamicResource TextPrimary}"
           HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Button x:Name="StatusPopupUpdateButton"
                                                Visibility="Collapsed"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Content="Update LexDesk Pro"
                                                Height="34"
                                                Margin="0,14,0,0"
                                                Click="UpdateAppButton_Click"/>

                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Address + Go -->
                            <Grid x:Name="AddressBarHost"
      MinWidth="80"
      VerticalAlignment="Center"
      HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="AddressBarBorder"
        Grid.Column="0"
        Height="{DynamicResource AddressBarHeight}"
        CornerRadius="16"
        Background="{DynamicResource InputBg}"
        BorderBrush="{DynamicResource ButtonBorder}"
        BorderThickness="1.2"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Padding="0">


                                    <TextBox x:Name="AddressBox"
         BorderThickness="0"
         Background="Transparent"
         Foreground="{DynamicResource TextPrimary}"
         VerticalContentAlignment="Center"
         HorizontalAlignment="Stretch"
         Padding="14,0,14,2"
         FontSize="{DynamicResource TopBarFontSize}"
         Height="{DynamicResource AddressBarHeight}"
         CaretBrush="{DynamicResource TextPrimary}"
         KeyDown="AddressBox_KeyDown"
         TextChanged="AddressBox_TextChanged"
         LostKeyboardFocus="AddressBox_LostKeyboardFocus"
         FocusVisualStyle="{x:Null}"
         TextWrapping="NoWrap"
         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
         ScrollViewer.VerticalScrollBarVisibility="Hidden"
         PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
         PreviewMouseRightButtonDown="AddressBox_PreviewMouseRightButtonDown"
         GotKeyboardFocus="AddressBox_GotKeyboardFocus"
         Focusable="True"
         IsReadOnly="False"/>
                                </Border>

                                <Button Grid.Column="1"
        Margin="{DynamicResource TopBarLeftGap}"
        Style="{StaticResource TopBarIconButtonStyle}"
        ToolTip="Navigate"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Foreground="{DynamicResource IconBrush}"
        Click="GoButton_Click">

                                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                                        <Path Data="M6 10 H14 M10.5 6.5 L14 10 L10.5 13.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                                </Button>


                            </Grid>

                            <!-- PAGE MODE BUTTONS (1-4) -->
                            <StackPanel x:Name="PageModePanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="3,0,0,0">

                                <Button x:Name="Page1Button"
        Style="{StaticResource TopBarIconButtonStyle}"
        Content="1"
        Width="{DynamicResource TopBarCompactButtonWidth}"
        MinWidth="{DynamicResource TopBarCompactButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        FontSize="{DynamicResource TopBarFontSize}"
        FontWeight="SemiBold"
        ToolTip="Web Page 1&#x0a;Left click: Show from Web Page 1&#x0a;Right click: Show only Web Page 1&#x0a;Click again to lock or unlock this Web Page"
Click="Page1Button_Click"
PreviewMouseRightButtonUp="Page1Button_PreviewMouseRightButtonUp"/>

                                <Button x:Name="Page2Button"
        Style="{StaticResource TopBarIconButtonStyle}"
        Content="2"
        Width="{DynamicResource TopBarCompactButtonWidth}"
        MinWidth="{DynamicResource TopBarCompactButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        FontSize="{DynamicResource TopBarFontSize}"
        FontWeight="SemiBold"
        ToolTip="Web Page 2&#x0a;Left click: Show Web Pages 1–2&#x0a;Right click: Show only Web Page 2&#x0a;Click again to lock or unlock this Web Page"
Click="Page2Button_Click"
PreviewMouseRightButtonUp="Page2Button_PreviewMouseRightButtonUp"/>

                                <Button x:Name="Page3Button"
        Style="{StaticResource TopBarIconButtonStyle}"
        Content="3"
        Width="{DynamicResource TopBarCompactButtonWidth}"
        MinWidth="{DynamicResource TopBarCompactButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        FontSize="{DynamicResource TopBarFontSize}"
        FontWeight="SemiBold"
        ToolTip="Web Page 3&#x0a;Left click: Show Web Pages 1–3&#x0a;Right click: Show only Web Page 3&#x0a;Click again to lock or unlock this Web Page"
Click="Page3Button_Click"
PreviewMouseRightButtonUp="Page3Button_PreviewMouseRightButtonUp"/>

                                <Button x:Name="Page4Button"
        Style="{StaticResource TopBarIconButtonStyle}"
        Content="4"
        Width="{DynamicResource TopBarCompactButtonWidth}"
        MinWidth="{DynamicResource TopBarCompactButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        FontSize="{DynamicResource TopBarFontSize}"
        FontWeight="SemiBold"
        ToolTip="Web Page 4&#x0a;Left click: Show Web Pages 1–4&#x0a;Right click: Show only Web Page 4&#x0a;Click again to lock or unlock this Web Page"
Click="Page4Button_Click"
PreviewMouseRightButtonUp="Page4Button_PreviewMouseRightButtonUp"/>

                                <Button x:Name="NewTabTopButton"
        Visibility="Collapsed"
        Style="{StaticResource TopBarIconButtonStyle}"
        ToolTip="New Tab"
        Click="NewTabTopButton_Click">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                                        <Path Data="M10 4 V16 M4 10 H16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Viewbox>
                                </Button>

                                <Button x:Name="PaneMinimizeButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarCompactButtonWidth}"
        MinWidth="{DynamicResource TopBarCompactButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        Margin="2,0,0,0"
        ToolTip="Minimise active Web Page"
        Click="MinimizeActivePaneButton_Click">
                                    <Grid Width="18" Height="18">
                                        <!-- Lifted slightly toward centre, matching the app Minimise glyph. -->
                                        <Path Data="M4 10.5 H14"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"/>
                                    </Grid>
                                </Button>

                                <Button x:Name="PaneMaxRestoreButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarCompactButtonWidth}"
        MinWidth="{DynamicResource TopBarCompactButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        Margin="2,0,0,0"
        ToolTip="Maximise / restore active Web Page"
        Click="PaneMaxRestoreButton_Click">
                                    <Grid Width="18" Height="18">
                                        <!-- Same fixed glyph size as the app Maximise button so both match their Close X. -->
                                        <Rectangle Width="10" Height="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   StrokeThickness="1.2"
                                                   Fill="Transparent"/>
                                    </Grid>
                                </Button>

                                <Button x:Name="PaneCloseButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Tag="CloseCaption"
        Width="{DynamicResource TopBarCompactButtonWidth}"
        MinWidth="{DynamicResource TopBarCompactButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        Margin="2,0,0,0"
        ToolTip="Close active Web Page"
        Click="PaneCloseButton_Click">
                                    <Grid Width="18" Height="18">
                                        <Path Data="M4 4 L14 14 M14 4 L4 14"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"/>
                                    </Grid>
                                </Button>

                            </StackPanel>

                        </StackPanel>
