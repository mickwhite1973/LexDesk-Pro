                                <!-- PROTECTION SHIELDS -->
                                <Expander Header="Protection Shields"
                  Margin="0,0,0,10">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Download Guard — warns before risky downloads. High-risk files need approval before continuing."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Site Shield — blocks dangerous website actions such as unsafe scripts or unsafe local commands."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Permission Shield — blocks unwanted website notification requests."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Popup Storm Shield — blocks websites that rapidly open too many popups."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Redirect Shield — warns when a site rapidly redirects too many times."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Scam Shield — looks for common fake virus, fake support, or scam warning language on a page."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Trust Site — allows a known download site to be treated as trusted for future downloads. High-risk files can still warn you."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- DOWNLOADS AND QUARANTINE -->
                                <Expander Header="Downloads &amp; Quarantine"
                  Margin="0,0,0,10">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Check File — checks a file before you open it. This is useful for downloads, email attachments, and files from USB drives."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Quarantine is a safe holding folder. LexDesk Pro copies medium and high-risk files there so you do not open them by accident."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>

                                            <TextBlock Text="Microsoft Defender scan may take several minutes. You can keep using LexDesk Pro while the scan runs."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
