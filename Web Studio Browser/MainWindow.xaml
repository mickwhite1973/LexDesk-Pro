                                    <Path Data="M5 7.5 A6 6 0 0 1 15 6 M15 6 V3 M15 6 H12" Stroke="{DynamicResource FeatureCyclePagesBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Path Data="M15 12.5 A6 6 0 0 1 5 14 M5 14 V17 M5 14 H8" Stroke="{DynamicResource FeatureCyclePagesBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="QuickCompatibilityButton"
        Visibility="Collapsed"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
