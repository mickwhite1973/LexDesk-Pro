                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Settings is organised into separate pages. Privacy &amp; Safety contains privacy controls, Popup Control, warnings and site lists. Browser Settings contains search and internet lookup choices. Page Settings contains Quick URLs, Auto Start, Clean Search, appearance, Memory Saver, backup and reset. Toolbar controls optional toolbar buttons and AI shortcuts. Activation &amp; Updates manages your licence and app updates."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Help and Information contains About &amp; Acknowledgements, the Welcome Guide, Full Guide and Contact Support."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

