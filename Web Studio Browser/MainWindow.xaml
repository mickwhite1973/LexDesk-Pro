                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.30"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="Calendar Reminder"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,5"/>

                    <TextBlock x:Name="LexDeskInAppReminderTitleText"
