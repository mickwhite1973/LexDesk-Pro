                    Click="LexDeskPage2TaskScheduler_Click"/>

                                    <Button Grid.Row="3"
                    Grid.Column="1"
                    Content="Advanced Firewall"
                    Height="40"
                    Margin="5,5,0,5"
                    Style="{StaticResource TopBarButtonStyle}"
                    Click="LexDeskPage2Firewall_Click"/>

                                    <Button Grid.Row="4"
                    Grid.Column="0"
                    Content="Performance Monitor"
                    Height="40"
                    Margin="0,5,5,0"
                    Style="{StaticResource TopBarButtonStyle}"
                    Click="LexDeskPage2PerformanceMonitor_Click"/>

                                    <Button Grid.Row="4"
                    Grid.Column="1"
                    Content="Computer Management"
                    Height="40"
                    Margin="5,5,0,0"
                    Style="{StaticResource TopBarButtonStyle}"
                    Click="LexDeskPage2ComputerManagement_Click"/>

                                </Grid>

                                <Separator Margin="0,16,0,12"/>

                                <Button Content="Back to Everyday Tools"
                Height="32"
                MinWidth="150"
                HorizontalAlignment="Right"
                Style="{StaticResource TopBarButtonStyle}"
