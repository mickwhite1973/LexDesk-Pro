                                <TextBlock Text="Choose a section below. Each section is written in plain language so LexDesk Pro is easy to learn."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="13"
                   Margin="0,0,0,14"/>

                                <!-- QUICK START -->
                                <Expander Header="Quick Start"
                  IsExpanded="True"
                  Margin="0,0,0,10">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="LexDesk Pro gives you a simpler place to use Windows and browse the web. Use Search PC and your pinned shortcuts on the bottom bar, LexDesk Start for Apps, Maintenance and Windows Tools, and the top area for websites, privacy controls and up to four Web Pages at once."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>

                                            <TextBlock Text="If you are not sure what to change, leave Privacy Level on Recommended, Popup Control on Smart, and Internet Protection on Normal. LexDesk Pro is designed so the safe everyday choices are already selected."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>

                                            <TextBlock Text="Tabs are groups of saved Web Pages. Web Pages are the numbered browsing areas 1 to 4."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- LEXDESK DESKTOP AND BOTTOM BAR -->
                                <Expander Header="LexDesk Desktop &amp; Bottom Bar"
          Margin="0,0,0,10">

                                    <Border BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12"
            Margin="0,8,0,0">

                                        <StackPanel>

                                            <TextBlock Text="Bottom bar"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="The bottom bar gives you Search PC, LexDesk Start, your pinned apps, permanent everyday shortcuts and system information. Windows Tools are now inside LexDesk Start so the bottom bar stays tidy."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Search PC"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Search PC searches this computer, not the web. Use it to find installed apps, files, folders and documents."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Search PC can also open common Windows tools when you type their normal name or command, including CMD, Task Manager, PowerShell, Registry Editor, Services, Event Viewer, Device Manager, Disk Management, System Information, Resource Monitor and Control Panel."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Advanced Windows tools can change important system settings. Only use them when you understand what they do."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Top search versus Search PC"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="The address bar at the top is used for websites and web searches. Search PC on the bottom bar is for the computer itself."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Apps"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Open Apps to see useful installed applications. LexDesk hides many installers, helper utilities and technical system entries so the list stays easier to understand."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Right-click an app to pin or unpin it from the bottom bar. Up to 6 user-pinned apps can be shown."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Permanent shortcuts"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="The coloured permanent shortcuts open File Explorer, Downloads, Notepad, Calculator, Windows Settings and Desktop."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Managed Windows workspace"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Windows apps can open over the Web Pages inside the LexDesk workspace while the LexDesk top and bottom bars stay available. With 1 Web Page the app uses the whole workspace. With 2, 3 or 4 Web Pages, new apps use the highest-numbered free Web Page first."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="The order is simple: 4, then 3, then 2, then 1. An app keeps its Web Page until you close it. If you minimise the app, the website underneath becomes visible again. Restore the app and it returns to the same Web Page."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Some security programs and Windows system screens may keep their own window size or open in the normal Windows way. That is intentional when Windows does not allow LexDesk to safely control the window."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="LexDesk Start"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="LexDesk Start provides LexDesk Home, Apps, Maintenance, Tools, Start with Windows and Back to Windows."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="The same menu also provides Restart PC and Shut Down PC."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

                                        </StackPanel>

                                    </Border>

                                </Expander>

                                <!-- TOOLBAR BUTTONS -->
                                <Expander Header="Toolbar Buttons"
          Margin="0,0,0,10">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12"
            Margin="0,8,0,0">
                                        <StackPanel>

                                            <TextBlock Text="Left Section — Tabs"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Tab buttons 1–5 — switch between your 5 saved Tab groups."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Each Tab has 4 saved Web Pages."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Tab 1 uses Quick URLs 1–4. Tab 2 uses Quick URLs 5–8. Tab 3 uses Quick URLs 9–12. Tab 4 uses Quick URLs 13–16. Tab 5 uses Quick URLs 17–20."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Back to Windows — click the Windows-style button beside Tab 5 to minimise LexDesk Pro."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Centre Section — Browsing"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Emergency — stops loading and returns to a safer screen."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Refresh — reloads the active Web Page."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Restore Closed Page — reopens the most recently closed Web Page."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Back / Forward — moves the active Web Page backward or forward."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Home — opens Quick URL 1 or your saved home page in the active Web Page."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Status Dot — shows whether browsing looks safe, protected, or needs attention. Click it to see details."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Address Bar — type a website address or search words, then press Enter or click Navigate."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Navigate — opens the address or search typed in the Address Bar."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Page buttons 1–4 — choose how many Web Pages are shown. If a Web Page is empty, it opens the matching Quick URL for the active Tab."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Small – button — if an app is covering the active Web Page, this minimises the app and shows the website underneath. If no app is covering it, this minimises the Web Page."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Small × button beside Web Page 1–4 — if an app is covering the active Web Page, this closes that app first and leaves the website underneath. If no app is covering it, it closes only the active Web Page."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="The active Web Page is highlighted with a blue outline, so you can see which Web Page your toolbar actions will affect."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Right Section — Tools"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Page Cycle — cycles the active Web Page through saved Quick URLs. Right-click it to choose a saved Quick URL directly."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Smart Compatibility — use this when a trusted website needs extra help with login, media, account or other essential functions. It keeps safer ad/tracker filtering where possible instead of turning protection fully off. When the button is orange, the current site is using Smart Compatibility. Right-click it to manage saved compatibility sites."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Settings — opens Privacy &amp; Safety, Browser Settings, Page Settings, Toolbar, Activation &amp; Updates, and Help and Information."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Privacy — opens privacy controls, allow lists, Block List updates, history delete, cookie/privacy tools, and site compatibility options."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Top-right minimise / maximise / close — controls the LexDesk Pro app window. The top-right × closes the app after a warning."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Menu — opens History, Favourites, Tools, Settings, Themes, Guide, Quarantine, and Check File."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- HOW TO -->
                                <Expander Header="How To"
          Margin="0,0,0,10">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12"
            Margin="0,8,0,0">
                                        <StackPanel>

                                            <TextBlock Text="Open a website"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Type a website address or search words into the Address Bar, then press Enter or click Navigate."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Use a Tab"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Click Tab 1, 2, 3, 4, or 5. These Tabs are always available, so there is no need to create or close Tabs."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="Each Tab gives you 4 saved Web Pages."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Switch Tabs"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Click Tab 1, 2, 3, 4, or 5 on the left side of the toolbar."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Back to Windows"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Click the Windows-style button beside Tab 5 to minimise LexDesk Pro and return to Windows."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Tidy a Tab"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Right-click a Tab number, then choose Close extra Web Pages or Reset Tab to Page 1."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="All 5 Tabs stay available."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Show 1, 2, 3, or 4 Web Pages"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Use the Web Page buttons 1–4 near the Address Bar."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="If a Web Page is empty, LexDesk Pro opens the matching Quick URL for the active Tab."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Save or edit Quick URLs"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
