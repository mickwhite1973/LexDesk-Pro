           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="Open Tools and choose Save as Favourite, or right-click the address bar and choose Add this page to Favourites."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Open favourites or history"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Open the Menu, then choose Favourites or History."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

