                                <!-- PRIVACY PROTECTION DNS -->
                                <Expander Header="Privacy &amp; Internet Protection"
          Margin="0,0,0,10">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12"
            Margin="0,8,0,0">
                                        <StackPanel>

                                            <TextBlock Text="Privacy Modes"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Privacy Modes control how strongly LexDesk Pro blocks trackers, ads, and risky web content."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Off — turns privacy blocking off."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,4"/>

                                            <TextBlock Text="Recommended — the everyday choice. It blocks common trackers and ads while keeping most websites working."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,4"/>

                                            <TextBlock Text="Compatibility — uses gentler filtering for trusted websites that need fewer restrictions."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,4"/>

                                            <TextBlock Text="Maximum — the strongest filtering. Some complicated websites may need Smart Compatibility if they do not work correctly."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Allow List and Blocked Site List"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="The Site Allow List is for trusted websites that need lighter blocking to work correctly."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="The Blocked Site List is your personal website block list. Add websites here when you want LexDesk Pro to block them."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="The Block List is different. It is the automatic protection list used for known ads, trackers, and unwanted web content."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Popup Control"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Popup Control helps manage websites that try to open extra windows or tabs."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Allow All — allows popups."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,4"/>

                                            <TextBlock Text="Smart — recommended. Allows normal website actions but blocks suspicious or unwanted popups."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,4"/>

                                            <TextBlock Text="Block All — blocks popups more aggressively."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Smart Compatibility"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Use Smart Compatibility when a trusted website does not load, sign in, stream, search, pay, or display correctly."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Smart Compatibility saves the trusted website to the Compatibility List and keeps essential site functions working without turning protection fully off."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,6"/>

                                            <TextBlock Text="When the Compatibility button is orange, the current site is using Smart Compatibility. Click the orange button to manage or remove saved compatibility sites."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Internet Protection"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Internet Protection keeps the everyday DNS choices simple."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Normal — recommended for most people. Leaves your Windows DNS alone, or restores the DNS settings LexDesk Pro saved before changing them."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,4"/>

                                            <TextBlock Text="Block Adult Content — optional Cloudflare Family filtering for malware, phishing and adult-content domains across Windows. Windows may ask for administrator permission."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,4"/>

                                            <TextBlock Text="To use a different lookup provider, open Browser Settings and choose the provider directly. LexDesk Pro handles the Windows change and Normal restores your saved DNS later."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>
                                            <TextBlock Text="Smart Mode"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="One-click setup quickly chooses a useful combination of Windows website lookup provider and search engine for common needs. Windows may ask for administrator permission when the lookup provider is applied."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="More Private — chooses privacy-focused settings."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,4"/>

                                            <TextBlock Text="Fast — chooses faster everyday browsing settings."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,4"/>

                                            <TextBlock Text="Safer — chooses stronger security-focused settings."
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextSecondary}"
           Margin="0,0,0,14"/>

                                            <TextBlock Text="Search Engine"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Search Engine controls which search provider is used when you type search words into the Address Bar."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Remember sign-in names"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextPrimary}"
           Margin="0,0,0,8"/>

                                            <TextBlock Text="LexDesk Pro can help trusted websites remember typed login names and email fields where the website allows it."
