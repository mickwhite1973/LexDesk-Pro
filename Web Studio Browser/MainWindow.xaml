                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="The safety rule"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       Margin="0,0,0,8"/>
