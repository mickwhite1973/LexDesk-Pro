        ToolTip="Smart Compatibility&#x0a;Left click: Help the current trusted site work while keeping safer blocking where possible&#x0a;Right click: Manage saved Compatibility sites"
        Click="CompatibilityForSite_Click"
        PreviewMouseRightButtonUp="CompatibilityButton_RightClick">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Path Data="M6.5 10 L9 12.5 L13.8 7.7" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="HistoryTopButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        Margin="3,0,0,0"
        ToolTip="View History"
        Visibility="Collapsed"
        Click="WebAction_History_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="13" Height="13" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Path Data="M10 6.5 V10 L12.8 11.7" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="BookmarksTopButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        Padding="0"
        Margin="3,0,0,0"
        ToolTip="Favourites&#x0a;Left click: Open saved favourites&#x0a;Right click: Save this page"
        Click="WebAction_ViewBookmarks_Click"
        PreviewMouseRightButtonUp="BookmarksTopButton_PreviewMouseRightButtonUp">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Path Data="M10 3.2 L12 7.2 L16.4 7.8 L13.2 10.9 L14 15.4 L10 13.3 L6 15.4 L6.8 10.9 L3.6 7.8 L8 7.2 Z" Stroke="{DynamicResource FeatureFavouritesBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Viewbox>
                        </Button>

                        <Button x:Name="ToolsTopButton"
        Style="{StaticResource TopBarIconButtonStyle}"
        Width="{DynamicResource TopBarButtonWidth}"
        Height="{DynamicResource TopBarButtonHeight}"
        ToolTip="Tools"
        Click="WebActionsButton_Click">

                            <Viewbox Width="18"
                                     Height="18"
                                     Stretch="Uniform">
                                <Canvas Width="20"
                                        Height="20">

                                    <Path Data="M3 5 H17 M3 10 H17 M3 15 H17"
                                          Stroke="{DynamicResource FeatureToolsBrush}"
