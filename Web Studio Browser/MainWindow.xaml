            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Right">


                        <Button x:Name="PrintTopButton"
Visibility="Collapsed"
Style="{StaticResource TopBarIconButtonStyle}"
